{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/chocolathon/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/|chocolathon/api/|chocolathon/assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(chocolathon/)?(hq|prompts|competitors|judge-c7m2x9|upload-k4n8pq|results-m3v8tq)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(chocolathon/)?(hq|prompts|competitors|judge-c7m2x9|upload-k4n8pq|results-m3v8tq)/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(chocolathon/)?api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/chocolathon/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
